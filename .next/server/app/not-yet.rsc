12:["$","$1","c",{"children":[[["$","section",null,{"className":"w-full flex flex-col justify-center min-h-[100svh] section-dark bg-[var(--color-sapphire)] text-[var(--color-pearl)] py-16 md:py-24 lg:py-28 pt-24 pb-20 md:pt-32 md:pb-28","children":["$","div",null,{"className":"w-full max-w-[1440px] mx-auto px-[10px]","children":["$","$L16",null,{"children":[["$","p",null,{"className":"text-xs uppercase tracking-[0.18em] text-[var(--color-gold)] mb-6","children":"NOT BOUGHT AI YET?"}],["$","h1",null,{"className":"text-[clamp(2.5rem,6vw,4.5rem)] font-light leading-[1.06] tracking-[-0.04em] max-w-[18ch] text-[var(--color-pearl)]","children":"Start with one job. Not a tool."}],["$","p",null,{"className":"mt-6 text-lg md:text-xl font-normal leading-relaxed text-[var(--color-slate)] max-w-[55ch]","children":"You do not need to buy software to fix a problem you have not priced yet. Start with the job that costs you the most time, and figure out what it would take to make that one run without you."}]]}]}]}],["$","section",null,{"className":"w-full flex flex-col justify-center bg-[var(--color-pearl)] text-[var(--color-ink)] lg:py-28 py-20 md:py-28","children":["$","div",null,{"className":"w-full max-w-[1440px] mx-auto px-[10px]","children":["$","$L16",null,{"children":["$","div",null,{"className":"max-w-[65ch]","children":[["$","p",null,{"className":"text-xs uppercase tracking-[0.16em] text-[var(--color-gold-deep)] font-normal mb-4","children":"WHAT THIS LOOKS LIKE IN PRACTICE"}],["$","h2",null,{"className":"text-[clamp(2rem,4vw,3.25rem)] font-light leading-[1.08] tracking-[-0.03em] text-[var(--color-ink)]","children":"Pick the job that still runs on memory and paper."}],["$","p",null,{"className":"mt-6 text-base md:text-lg font-normal leading-relaxed text-[var(--color-ink)]","children":"Every business has one. The weekly rota. The invoicing that happens when someone remembers. The onboarding step that takes an afternoon because nobody wrote down how it works. The quoting process that lives in someone's head."}],["$","p",null,{"className":"mt-4 text-base md:text-lg font-normal leading-relaxed text-[var(--color-ink)]","children":"We start with that one job. Not the whole business. Not a platform. One process that costs you real time every week, and an honest look at what it would take to make it run as a system instead of a habit."}]]}]}]}]}],["$","section",null,{"className":"w-full flex flex-col justify-center section-dark bg-[var(--color-sapphire)] text-[var(--color-pearl)] lg:py-28 py-20 md:py-28","children":["$","div",null,{"className":"w-full max-w-[1440px] mx-auto px-[10px]","children":["$","$L16",null,{"children":["$","div",null,{"className":"max-w-[65ch]","children":[["$","p",null,{"className":"text-xs uppercase tracking-[0.16em] text-[var(--color-gold)] font-normal mb-4","children":"PROOF THIS IS A METHOD"}],["$","h2",null,{"className":"text-[clamp(2rem,4vw,3.25rem)] font-light leading-[1.08] tracking-[-0.03em] text-[var(--color-pearl)]","children":"A care home's rota lived in a spreadsheet. We rebuilt it as a system."}],["$","p",null,{"className":"mt-6 text-base md:text-lg font-normal leading-relaxed text-[var(--color-pearl)]/85","children":"The home planned every month in one shared Excel file. Staff were typed into a grid by hand. Nobody could see the wage bill against budget until the month was already spent."}],["$","p",null,{"className":"mt-4 text-base md:text-lg font-normal leading-relaxed text-[var(--color-pearl)]/85","children":"We rebuilt it as one system that handles shifts, cost, coverage and compliance in a single place. It is running now."}],["$","div",null,{"className":"mt-6","children":["$","$L6",null,{"href":"/proof/care-rota","className":"inline-flex items-center text-base font-normal text-[var(--color-gold)] hover:text-[var(--color-pearl)] underline underline-offset-4 transition-colors cursor-pointer","children":"Read the full case study →"}]}]]}]}]}]}],"$L17"],null,"$L18"]}]
