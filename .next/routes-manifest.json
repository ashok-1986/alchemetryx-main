{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/about/",
      "destination": "/about",
      "statusCode": 308,
      "regex": "^(?!/_next)/about/(?:/)?$"
    },
    {
      "source": "/blueprints",
      "destination": "/about",
      "statusCode": 308,
      "regex": "^(?!/_next)/blueprints(?:/)?$"
    },
    {
      "source": "/blueprints/:path*",
      "destination": "/about",
      "statusCode": 308,
      "regex": "^(?!/_next)/blueprints(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/approach",
      "destination": "/about",
      "statusCode": 308,
      "regex": "^(?!/_next)/approach(?:/)?$"
    },
    {
      "source": "/approach/:path*",
      "destination": "/about",
      "statusCode": 308,
      "regex": "^(?!/_next)/approach(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/insights",
      "destination": "/about",
      "statusCode": 308,
