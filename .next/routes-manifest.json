    },
    {
      "source": "/start-your-pilot/:path*",
      "destination": "/book",
      "statusCode": 308,
      "regex": "^(?!/_next)/start-your-pilot(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
